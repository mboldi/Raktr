{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>BSStudio/renovate-config",
    "github>BSStudio/renovate-config:weekly"
  ],
  "packageRules": [
    {
      "description": "Gradle wrapper",
      "matchManagers": ["gradle-wrapper"],
      "additionalBranchPrefix": "backend/",
      "addLabels": ["backend"]
    },
    {
      "description": "Backend major updates",
      "matchManagers": ["gradle"],
      "matchFileNames": ["backend/**"],
      "matchUpdateTypes": ["major"],
      "additionalBranchPrefix": "backend/",
      "addLabels": ["backend"],
      "groupName": "backend major"
    },
    {
      "description": "Backend minor and patch updates",
      "matchManagers": ["gradle"],
      "matchFileNames": ["backend/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "additionalBranchPrefix": "backend/",
      "addLabels": ["backend"],
      "groupName": "backend non-major"
    },
    {
      "description": "Frontend major updates",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["major"],
      "additionalBranchPrefix": "frontend/",
      "addLabels": ["frontend"],
      "groupName": "frontend major"
    },
    {
      "description": "Frontend minor and patch updates",
      "matchManagers": ["npm"],
      "matchFileNames": ["frontend/**"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "additionalBranchPrefix": "frontend/",
      "addLabels": ["frontend"],
      "groupName": "frontend non-major"
    },
    {
      "description": "TypeScript is capped by the Angular compiler peer range \">=6.0 <6.1\"",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    },
    {
      "description": "Vitest is capped by the Angular unit-test builder peer range \"^4.0.8\"",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vitest"],
      "allowedVersions": "<5"
    },
    {
      "description": "Java runtime in setup-java: major upgrades only, never pinned.",
      "matchDatasources": ["java-version"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "enabled": false
    },
    {
      "description": "Docker base images: majors only.",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "enabled": false
    }
  ]
}
